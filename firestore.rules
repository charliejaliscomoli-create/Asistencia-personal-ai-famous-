rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public test probe for connection validation
    match /test/{testId} {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // Calendar Events subcollection
      match /events/{eventId} {
        allow get: if isOwner(userId) && isValidId(eventId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(eventId);
      }

      // Alarms subcollection
      match /alarms/{alarmId} {
        allow get: if isOwner(userId) && isValidId(alarmId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(alarmId);
      }

      // Reminders subcollection
      match /reminders/{reminderId} {
        allow get: if isOwner(userId) && isValidId(reminderId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(reminderId);
      }

      // Notes subcollection
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(noteId);
      }

      // WhatsApp messages subcollection
      match /whatsapp/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(messageId);
      }

      // Emails subcollection
      match /emails/{emailId} {
        allow get: if isOwner(userId) && isValidId(emailId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(emailId);
      }
    }
  }
}
