{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil básico del usuario autenticado",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID de usuario correspondiente a request.auth.uid"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Correo electrónico del usuario"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Nombre para mostrar del usuario"
        },
        "createdAt": {
          "type": "string",
          "description": "Fecha de creación del perfil"
        }
      },
      "required": ["id", "email"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Evento de calendario agendado por el asistente o el usuario",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único del evento"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Título o asunto de la cita"
        },
        "date": {
          "type": "string",
          "description": "Fecha en formato YYYY-MM-DD"
        },
        "time": {
          "type": "string",
          "description": "Hora en formato HH:mm"
        },
        "durationMinutes": {
          "type": "number",
          "description": "Duración en minutos"
        },
        "location": {
          "type": "string",
          "maxLength": 200,
          "description": "Ubicación opcional del evento"
        },
        "category": {
          "type": "string",
          "enum": ["trabajo", "personal", "salud", "reunión"],
          "description": "Categoría del evento"
        },
        "syncedToGoogleCalendar": {
          "type": "boolean",
          "description": "Indica si se sincronizó con Google Calendar"
        }
      },
      "required": ["id", "title", "date", "time"]
    },
    "Alarm": {
      "title": "Alarm",
      "description": "Alarma programada por voz o manualmente",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único de la alarma"
        },
        "time": {
          "type": "string",
          "description": "Hora de la alarma en formato HH:mm"
        },
        "label": {
          "type": "string",
          "maxLength": 100,
          "description": "Etiqueta descriptiva"
        },
        "enabled": {
          "type": "boolean",
          "description": "Estado de activación"
        },
        "days": {
          "type": "array",
          "description": "Días de la semana en los que suena"
        }
      },
      "required": ["id", "time", "label", "enabled"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Recordatorio creado por el asistente",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador del recordatorio"
        },
        "text": {
          "type": "string",
          "maxLength": 500,
          "description": "Texto del recordatorio"
        },
        "dueTime": {
          "type": "string",
          "description": "Hora límite opcional"
        },
        "dueDate": {
          "type": "string",
          "description": "Fecha límite opcional"
        },
        "completed": {
          "type": "boolean",
          "description": "Estado de completado"
        },
        "priority": {
          "type": "string",
          "enum": ["alta", "media", "baja"],
          "description": "Nivel de prioridad"
        }
      },
      "required": ["id", "text", "completed"]
    },
    "Note": {
      "title": "Note",
      "description": "Nota dictada o escrita",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador de la nota"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Título de la nota"
        },
        "content": {
          "type": "string",
          "maxLength": 5000,
          "description": "Contenido de la nota"
        },
        "updatedAt": {
          "type": "string",
          "description": "Fecha y hora de actualización"
        },
        "tags": {
          "type": "array",
          "description": "Etiquetas de categorización"
        }
      },
      "required": ["id", "title", "content"]
    },
    "WhatsAppMessage": {
      "title": "WhatsAppMessage",
      "description": "Mensaje dictado para WhatsApp",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador del mensaje"
        },
        "recipientName": {
          "type": "string",
          "maxLength": 100,
          "description": "Nombre del destinatario"
        },
        "recipientPhone": {
          "type": "string",
          "maxLength": 30,
          "description": "Teléfono del destinatario"
        },
        "message": {
          "type": "string",
          "maxLength": 2000,
          "description": "Cuerpo del mensaje"
        },
        "timestamp": {
          "type": "string",
          "description": "Marca de tiempo"
        },
        "status": {
          "type": "string",
          "enum": ["borrador", "enviado"],
          "description": "Estado de envío"
        }
      },
      "required": ["id", "recipientName", "message", "status"]
    },
    "EmailMessage": {
      "title": "EmailMessage",
      "description": "Borrador o registro de correo electrónico",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador del correo"
        },
        "to": {
          "type": "string",
          "maxLength": 200,
          "description": "Destinatario del correo"
        },
        "subject": {
          "type": "string",
          "maxLength": 300,
          "description": "Asunto del correo"
        },
        "body": {
          "type": "string",
          "maxLength": 10000,
          "description": "Cuerpo del correo"
        },
        "timestamp": {
          "type": "string",
          "description": "Marca de tiempo"
        },
        "read": {
          "type": "boolean",
          "description": "Estado de lectura"
        },
        "type": {
          "type": "string",
          "enum": ["recibido", "borrador", "enviado"],
          "description": "Tipo de correo"
        }
      },
      "required": ["id", "to", "subject", "body", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Perfil privado de cada usuario"
    },
    "/users/{userId}/events/{eventId}": {
      "schema": "CalendarEvent",
      "description": "Citas de calendario pertenecientes al usuario"
    },
    "/users/{userId}/alarms/{alarmId}": {
      "schema": "Alarm",
      "description": "Alarmas pertenecientes al usuario"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "Recordatorios pertenecientes al usuario"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "Notas dictadas y almacenadas por el usuario"
    },
    "/users/{userId}/whatsapp/{messageId}": {
      "schema": "WhatsAppMessage",
      "description": "Mensajes preparados de WhatsApp del usuario"
    },
    "/users/{userId}/emails/{emailId}": {
      "schema": "EmailMessage",
      "description": "Correos y borradores del usuario"
    }
  }
}
